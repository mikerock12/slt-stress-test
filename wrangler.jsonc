// Assets + API de benchmarks. Aplicar migrações D1 antes do deploy.
{
  "name": "slt-stress-test",
  "compatibility_date": "2026-10-19",
  "main": "worker/index.js",
  "vars": { "AMBIENTE": "producao" },
  "triggers": { "crons": ["0 6 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "slt-stress-test-benchmarks", "database_id": "267f4cce-4746-4234-83e8-66b29d757a5b", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "ENVIOS", "namespace_id": "52991", "simple": { "limit": 10, "period": 60 } }],
  "routes": [
    { "pattern": "stresstest.smellsliketech.com.br", "custom_domain": true }
  ]
}
